# LLM Provider — set to "openai" when you have an API key, "ollama" for local
LLM_PROVIDER=openai
OPENAI_API_KEY=your-key-here

# Workspace to scan (dot = current directory)
WORKSPACE_PATH=.

# Where decisions are stored (relative to WORKSPACE_PATH)
DECISIONS_PATH=.kiro/decisions

# Embedding model for semantic search
EMBEDDING_MODEL=all-MiniLM-L6-v2
