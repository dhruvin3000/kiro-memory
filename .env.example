# Copy this to .env and fill in your values

# LLM Provider (openai | bedrock | ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Ollama (if using local model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Workspace to scan (defaults to current directory)
WORKSPACE_PATH=.

# Decisions output path (relative to workspace)
DECISIONS_PATH=.kiro/decisions

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
